{
  "description": "Reminds Claude at session start to load the dispatch skill, and blocks commands that call codex exec / codex review directly so Codex is always called through the foreman-en script",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-reminder.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard-direct-calls.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
